#!/bin/bash
set -e

# Post-removal script for calendar-notifications-modal

case "$1" in
    purge)
        # On purge, inform user about config/data removal
        echo "Package purged. User configuration and data remain at:"
        echo "  ~/.config/calendar-notifications-modal/"
        echo "  ~/.local/share/calendar-notifications-modal/"
        echo ""
        echo "To remove these manually, run:"
        echo "  rm -rf ~/.config/calendar-notifications-modal"
        echo "  rm -rf ~/.local/share/calendar-notifications-modal"
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
