#!/bin/bash
set -e

# Pre-removal script for calendar-notifications-modal

case "$1" in
    remove|upgrade|deconfigure)
        # Stop the systemd user service for all users if running
        # Note: This may not work for all users; they should stop it manually
        echo "Stopping calendar-notifications-modal service..."
        # We can't easily stop services for all users, so just inform
        echo "Please stop your service manually with:"
        echo "  systemctl --user stop calendar-notifications-modal.service"
        ;;

    failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
