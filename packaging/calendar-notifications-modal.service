[Unit]
Description=Calendar Notifications Modal (Outlook-style upcoming-event reminders)
Documentation=https://example.com/calendar-notifications-modal
# Start once the graphical session (and its Wayland/X11 + D-Bus env) is available.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# User units can't depend on the system network-online.target, so wait for
# NetworkManager connectivity here instead (avoids a spurious gcal token-fetch
# warning at login). '-' prefix: a timeout must not block startup, the app
# already retries backend fetches on its own.
ExecStartPre=-/usr/bin/nm-online -q --timeout=30
ExecStart=%h/.local/bin/calendar-notifications-modal
Restart=on-failure
RestartSec=5
# Adjust verbosity with: RUST_LOG=debug
Environment=RUST_LOG=info

[Install]
WantedBy=graphical-session.target
